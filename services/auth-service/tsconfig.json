{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../../",
    "baseUrl": "../../",
    "paths": {
      "@shared/*": ["shared/*"],
      "@auth/*": ["services/auth-service/src/*"]
    },
    "typeRoots": [
      "../../node_modules/@types",
      "./src/types"
    ]
  },
  "include": [
    "src/**/*",
    "../../shared/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}