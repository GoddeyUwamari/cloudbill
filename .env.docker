# ============================================================================
# CloudBill - Docker Environment Variables
# Phase 2: PostgreSQL + Redis Configuration
# ============================================================================
# These variables are used by docker-compose.yml
# You can override these values for different environments

# ----------------------------------------------------------------------------
# PostgreSQL Configuration
# ----------------------------------------------------------------------------
# Database connection settings for Docker PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=cloudbill
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
# Cache and session store settings for Docker Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis123

# ----------------------------------------------------------------------------
# Notes:
# ----------------------------------------------------------------------------
# 1. Port 5433 is used to avoid conflict with local PostgreSQL on 5432
# 2. Port 6380 is used to avoid conflict with local Redis on 6379
# 3. These are development credentials - NEVER use in production
# 4. For production, use secrets management (Docker secrets, AWS Secrets Manager, etc.)
# 5. This file should be in .gitignore for production environments
# 6. Redis password is required for authentication (security best practice)

# ----------------------------------------------------------------------------
# Usage:
# ----------------------------------------------------------------------------
# Docker Compose automatically reads this file
# Services can reference these as: ${POSTGRES_DB}, ${REDIS_PASSWORD}
# Your application will connect using these values
# Example: redis://redis123@localhost:6380