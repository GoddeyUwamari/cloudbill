# ============================================================================
# CloudBill - Docker Environment Variables
# Phase 4: PostgreSQL + Redis + Auth Service + API Gateway Configuration
# ============================================================================
# These variables are used by docker-compose.yml
# You can override these values for different environments

# ----------------------------------------------------------------------------
# PostgreSQL Configuration
# ----------------------------------------------------------------------------
# Database connection settings for Docker PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=cloudbill
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ----------------------------------------------------------------------------
# Redis Configuration
# ----------------------------------------------------------------------------
# Cache and session store settings for Docker Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis123

# ----------------------------------------------------------------------------
# Auth Service Configuration
# ----------------------------------------------------------------------------
# JWT (JSON Web Token) secrets for authentication
# IMPORTANT: Change these in production! Use long, random strings
JWT_SECRET=your-super-secret-jwt-key-change-in-production-use-at-least-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-use-at-least-32-characters

# JWT Token Expiration (configured in docker-compose.yml)
# Access Token: 15m (15 minutes)
# Refresh Token: 7d (7 days)

# ----------------------------------------------------------------------------
# API Gateway Configuration
# ----------------------------------------------------------------------------
# API Gateway server settings
API_GATEWAY_PORT=8080

# CORS (Cross-Origin Resource Sharing) allowed origins
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Service URLs (Internal Docker network - for reference)
# These use Docker service names for internal communication
# AUTH_SERVICE_URL=http://auth-service:3001
# BILLING_SERVICE_URL=http://billing-service:3002
# PAYMENT_SERVICE_URL=http://payment-service:3003
# NOTIFICATION_SERVICE_URL=http://notification-service:3004
# ANALYTICS_SERVICE_URL=http://analytics-service:3005

# ----------------------------------------------------------------------------
# Notes:
# ----------------------------------------------------------------------------
# 1. Port 5433 is used to avoid conflict with local PostgreSQL on 5432
# 2. Port 6380 is used to avoid conflict with local Redis on 6379
# 3. Port 8080 is used for API Gateway (standard for APIs)
# 4. These are development credentials - NEVER use in production
# 5. For production, use secrets management (Docker secrets, AWS Secrets Manager, etc.)
# 6. This file should be in .gitignore for production environments
# 7. Redis password is required for authentication (security best practice)
# 8. JWT secrets should be long random strings (minimum 32 characters)
# 9. Generate production secrets using: openssl rand -base64 32
# 10. Service URLs are configured in docker-compose.yml using Docker service names

# ----------------------------------------------------------------------------
# Usage:
# ----------------------------------------------------------------------------
# Docker Compose automatically reads this file
# Services can reference these as: ${POSTGRES_DB}, ${REDIS_PASSWORD}, ${JWT_SECRET}
# Your application will connect using these values
# Example: redis://redis123@localhost:6380
# API Gateway accessible at: http://localhost:8080
# ============================================================================