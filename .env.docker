# ============================================================================
# CloudBill - Docker Environment Variables
# Phase 1: PostgreSQL Configuration
# ============================================================================
# These variables are used by docker-compose.yml
# You can override these values for different environments

# ----------------------------------------------------------------------------
# PostgreSQL Configuration
# ----------------------------------------------------------------------------
# Database connection settings for Docker PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=cloudbill
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ----------------------------------------------------------------------------
# Notes:
# ----------------------------------------------------------------------------
# 1. Port 5433 is used to avoid conflict with local PostgreSQL on 5432
# 2. These are development credentials - NEVER use in production
# 3. For production, use secrets management (Docker secrets, AWS Secrets Manager, etc.)
# 4. This file should be in .gitignore for production environments

# ----------------------------------------------------------------------------
# Usage:
# ----------------------------------------------------------------------------
# Docker Compose automatically reads this file
# Services can reference these as: ${POSTGRES_DB}
# Your application will connect using these values